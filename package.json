{
  "name": "clitronic",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "release:check": "npm run audit:prod && npm run validate && npm test && npm run build && npm --prefix cli run audit:prod && npm --prefix cli run type-check && npm --prefix cli test && npm --prefix cli run start -- --help",
    "validate": "npm run type-check && npm run lint && npm run format:check",
    "test": "tsx --test",
    "scaffold:component": "node scripts/scaffold-component.mjs"
  },
  "dependencies": {
    "next": "^16.3.4",
    "openai": "^6.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.18.7",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.9.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
